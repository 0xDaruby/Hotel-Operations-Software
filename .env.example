NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: never give the service-role key a NEXT_PUBLIC_ prefix.
# Hotel time zone and inspection schedule are database-owned.
# Optional unused API/Prisma scaffold settings:
# API_ORIGIN=http://localhost:3001
# DATABASE_URL=postgresql://hotel:hotel@localhost:5432/hotel_operations
